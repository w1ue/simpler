{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minimal simpler WSE CPU protocol deployment input with KV quota",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "program",
    "placement",
    "capacity_bytes",
    "transport",
    "kv_quota"
  ],
  "properties": {
    "format": {
      "const": "simpler.wse.deployment.v2"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "sha256"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "home_core_by_slot",
        "routed_expert_core",
        "shared_expert_core_by_chip"
      ],
      "properties": {
        "home_core_by_slot": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "enum": [
              0,
              8
            ]
          }
        },
        "routed_expert_core": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        },
        "shared_expert_core_by_chip": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    },
    "capacity_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sram_per_core",
        "bailu_per_chip",
        "host_per_chip",
        "batcher_per_endpoint"
      ],
      "properties": {
        "sram_per_core": {
          "$ref": "#/$defs/capacity"
        },
        "bailu_per_chip": {
          "$ref": "#/$defs/capacity"
        },
        "host_per_chip": {
          "$ref": "#/$defs/capacity"
        },
        "batcher_per_endpoint": {
          "$ref": "#/$defs/capacity"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbox_entries_per_core",
        "queue_entries_per_endpoint"
      ],
      "properties": {
        "inbox_entries_per_core": {
          "$ref": "#/$defs/entries"
        },
        "queue_entries_per_endpoint": {
          "$ref": "#/$defs/entries"
        }
      }
    },
    "kv_quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pool_pages_per_chip",
        "initial_pages_per_request",
        "refill_pages",
        "low_watermark_pages",
        "exhaustion_policy",
        "control_inbox_entries_per_core",
        "control_queue_entries_per_endpoint"
      ],
      "properties": {
        "pool_pages_per_chip": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "initial_pages_per_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "refill_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "low_watermark_pages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "exhaustion_policy": {
          "enum": [
            "wait",
            "deny"
          ]
        },
        "control_inbox_entries_per_core": {
          "$ref": "#/$defs/entries"
        },
        "control_queue_entries_per_endpoint": {
          "$ref": "#/$defs/entries"
        }
      }
    }
  },
  "$defs": {
    "capacity": {
      "type": "integer",
      "minimum": 128,
      "maximum": 9007199254740991,
      "multipleOf": 128
    },
    "entries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "$comment": "prepare_deployment.py additionally checks hashes, program ABI, role ownership and per-owner capacity. No native WSE API is claimed."
}
